{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": {
      "script": "bun run build",
      "wait": true
    },
    "beforeBuildCommand": "bun run build"
  },
  "bundle": {
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.macos.plist",
      "infoPlist": "Info.macos.plist"
    }
  }
}
